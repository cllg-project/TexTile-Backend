# Example environment variables for development
# Copy this file to `.env` and update values as needed.

# cache
#PRERENDER_DIR=/path/to/cache
USE_DISK_CACHE=true

# Application Configuration
USE_ELASTICSEARCH=true

# Elasticsearch Configuration
# Use http(s)://host:port
ELASTICSEARCH_HOST=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX=documents_v5
ELASTICSEARCH_VERIFY_CERTS=false

# Public address of the API, used to generate every link in API responses
# (DTS entry point, collection/document/navigation templates, pagination).
# Leave empty in local development: links then follow the request.
# Examples: https://comma.example.org/   or, under a path prefix, https://example.org/dts/
#PUBLIC_BASE_URL=
# Alternative behind a proxy that sends X-Forwarded-* headers: number of proxies to trust.
# Ignored when PUBLIC_BASE_URL is set.
#TRUSTED_PROXY_HOPS=1

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=true

# CORS allowed origins (comma-separated)
# Example: ALLOWED_ORIGINS=http://localhost:3000,http://comma.inria.fr
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Vector Search Configuration (when available)
VECTOR_SEARCH_MODEL=paraphrase-multilingual-MiniLM-L12-v2
VECTOR_INDEX=documents_with_vectors

# Heavy requests (statistics, CSV exports): see the README.
# Most occurrences one statistics scan counts, and its time budget in seconds
#STATS_MAX_OCCURRENCES=100000
#STATS_MAX_SECONDS=60
# How many may run at once, per gunicorn worker (more get a 503 + Retry-After)
#STATS_MAX_CONCURRENT=2
#EXPORT_MAX_CONCURRENT=4
# Saved statistics (shared by the workers); default: <PRERENDER_DIR>/api-cache
#API_CACHE_DIR=/var/cache/textile-api

# gunicorn (see gunicorn.conf.py)
#WEB_CONCURRENCY=4
#GUNICORN_THREADS=8
#LOG_LEVEL=info
