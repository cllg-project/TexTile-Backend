# Use Python 3.10 slim image
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for better Docker layer caching)
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app/ ./app/
COPY assets/ ./assets/
COPY gunicorn.conf.py .
COPY es_indexer_textile.py migrate.py update_extent_in_db.py update_source_in_db.py ./
# Configuration is injected at runtime (docker run --env-file .env ...), never baked into the image

# Create necessary directories
RUN mkdir -p cache data temp

# Set environment variables
ENV FLASK_APP=app
ENV FLASK_ENV=production
ENV PYTHONPATH=/app

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:5000/health || exit 1

# Run the application
# Workers, threads, timeouts and log level: gunicorn.conf.py, overridable with environment variables
CMD ["gunicorn", "-c", "gunicorn.conf.py", "app:app"]